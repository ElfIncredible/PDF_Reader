# Shared secret. The app sends it as "Authorization: Bearer <token>". Make it long and random:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FOLIO_TOKEN=change-me

# --- AI model -------------------------------------------------------------
# Option A (default): local Ollama from docker-compose. Free, and documents never leave your machine.
LLM_PROVIDER=openai
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=

# Option B: a hosted OpenAI-compatible API (OpenAI, Groq, Together, …)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<model name>
# LLM_API_KEY=<your key>

# Option C: Anthropic (Claude)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# LLM_API_KEY=<your key>

# Option D: no AI (conversions and tables only)
# LLM_PROVIDER=none

LLM_TIMEOUT=180
# Text per model call; bigger documents are summarised in parts. Raise it for models with big context windows.
MAX_CONTEXT_CHARS=24000
MAX_UPLOAD_MB=60
